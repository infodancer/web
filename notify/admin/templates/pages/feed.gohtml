{{define "content"}}
{{- $base := .BasePath -}}
{{- $view := .Page -}}
<nav class="notify-scope" aria-label="Feed scope">
  {{- /* Two views: the curated admin-audience stream (default) and the full
         activity firehose across every audience. */ -}}
  <a href="{{$base}}/"
     hx-get="{{$base}}/" hx-target="#notify-list" hx-swap="innerHTML" hx-push-url="true"
     class="notify-scope-tab{{if ne $view.Filter.Scope "all"}} is-active{{end}}"
     {{if ne $view.Filter.Scope "all"}}aria-current="page"{{end}}>Admin</a>
  <a href="{{$base}}/?scope=all"
     hx-get="{{$base}}/?scope=all" hx-target="#notify-list" hx-swap="innerHTML" hx-push-url="true"
     class="notify-scope-tab{{if eq $view.Filter.Scope "all"}} is-active{{end}}"
     {{if eq $view.Filter.Scope "all"}}aria-current="page"{{end}}>All activity</a>
</nav>
<div class="notify-toolbar">
  <form class="notify-filter" hx-get="{{$base}}/" hx-target="#notify-list"
        hx-swap="innerHTML" hx-push-url="true">
    <input type="hidden" name="scope" value="{{$view.Filter.Scope}}">
    <input type="search" name="type" value="{{$view.Filter.Type}}" placeholder="type, e.g. user.created">
    <input type="search" name="source" value="{{$view.Filter.Source}}" placeholder="source">
    <select name="severity" aria-label="Severity">
      <option value="">any severity</option>
      <option value="info"   {{if eq $view.Filter.Severity "info"}}selected{{end}}>info</option>
      <option value="notice" {{if eq $view.Filter.Severity "notice"}}selected{{end}}>notice</option>
      <option value="warn"   {{if eq $view.Filter.Severity "warn"}}selected{{end}}>warn</option>
      <option value="alert"  {{if eq $view.Filter.Severity "alert"}}selected{{end}}>alert</option>
    </select>
    <input type="date" name="since" value="{{$view.Filter.Since}}" aria-label="Since">
    <button type="submit">Filter</button>
  </form>
  {{- /* Mark-all-read advances the read cursor and fires the notify:read event
         (see the seen handler) that the host's embedded bell listens for; the
         bell is not on this page, so nothing here is swapped. */ -}}
  <form class="notify-markread" hx-post="{{$base}}/seen" hx-swap="none">
    <input type="hidden" name="up_to" value="{{$view.NewestCreatedAt}}">
    <button type="submit"{{if not $view.Events}} disabled{{end}}>Mark all read</button>
  </form>
</div>
<ul id="notify-list" class="notify-list" role="list">
{{template "partials/feed_list.gohtml" $view}}
</ul>
{{end}}
