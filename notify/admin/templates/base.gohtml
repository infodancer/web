<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{with .PageTitle}}{{.}} — {{end}}{{.SiteName}}</title>
<link rel="stylesheet" href="{{.BasePath}}/static/ui/css/tokens.css">
<link rel="stylesheet" href="{{.BasePath}}/static/ui/css/base.css">
<link rel="stylesheet" href="{{.BasePath}}/static/notify.css">
{{.HTMXHead}}
</head>
<body class="notify">
<header class="app-nav notify-header">
  <a class="app-nav-brand" href="{{.HomeURL}}">{{.SiteName}}</a>
  <span class="app-nav-sep" aria-hidden="true">/</span>
  <a class="app-nav-section" href="{{.BasePath}}/">Notifications</a>
  <span id="notify-bell" class="notify-bell-slot"
        hx-get="{{.BasePath}}/bell" hx-trigger="load, every {{.PollSeconds}}s">
    {{template "partials/bell.gohtml" .}}
  </span>
</header>
<main class="app-container notify-main">
{{template "content" .}}
</main>
</body>
</html>
