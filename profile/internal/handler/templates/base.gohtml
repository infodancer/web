{{- /*
  base.gohtml renders every full profile page through infodancer/ui's Layer 2
  ui/document (chrome owned by ui, skinnable per request via Config.Chrome).
  The page template supplies the content/title blocks; the embedded
  ui.DocumentData on the view supplies ui/document's chrome fields.

  The head block carries mdedit's asset tags on the edit page. Canonical URLs
  and JSON-LD ride ui/meta via the Meta field.
*/ -}}
{{ define "head" }}
{{- with .EditorHead }}
  {{ . }}
{{- end }}
{{ end }}
{{ template "ui/document" . }}
