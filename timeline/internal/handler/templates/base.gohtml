{{- /*
  base.gohtml renders every full timeline page. Normal requests go through
  infodancer/ui's Layer 2 ui/document (chrome owned by ui, skinnable per request
  via Config.Chrome); ?embed=true renders the chrome-less document for iframe
  embedding. The page template supplies the content/title/head blocks; the
  embedded ui.DocumentData on the view supplies ui/document's chrome fields.
*/ -}}
{{ if .Embed }}{{ template "timeline/embed" . }}{{ else }}{{ template "ui/document" . }}{{ end }}
