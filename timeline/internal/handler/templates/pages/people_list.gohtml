{{ define "title" }}People - {{ .Page.Timeline.Name }}{{ end }}

{{ define "content" }}
{{- $base := .BasePath -}}
{{- $v := .Page -}}
<div class="page-people-list">
  <nav class="breadcrumb">
    <a href="{{ $base }}/">Timelines</a> /
    <a href="{{ $base }}/t/{{ $v.Timeline.Slug }}">{{ $v.Timeline.Name }}</a> /
    <span>People</span>
  </nav>

  <h1>People</h1>

  {{ if $v.People }}
  <div class="people-grid">
    {{ range $v.People }}
    <a href="{{ $base }}/t/{{ $v.Timeline.Slug }}/person/{{ .Slug }}" class="people-card">
      {{ if .PhotoUrl }}<img class="people-card-thumb" src="{{ .PhotoUrl }}" alt="{{ .Name }}" loading="lazy">
      {{ else }}<div class="people-card-thumb people-card-placeholder">{{ slice .Name 0 1 }}</div>
      {{ end }}
      <div class="people-card-info">
        <h2>{{ .Name }}</h2>
        {{ if or .BornDate.Valid .DiedDate.Valid }}
        <div class="people-card-dates">
          {{ if .BornDate.Valid }}{{ .BornDate.Time.Format "2006" }}{{ end }}
          {{ if and .BornDate.Valid .DiedDate.Valid }}&ndash;{{ end }}
          {{ if .DiedDate.Valid }}{{ .DiedDate.Time.Format "2006" }}{{ end }}
        </div>
        {{ end }}
      </div>
    </a>
    {{ end }}
  </div>
  {{ else }}
  <p class="empty-state">No people recorded for this timeline.</p>
  {{ end }}

  <a href="{{ $base }}/t/{{ $v.Timeline.Slug }}" class="back-link">Back to timeline</a>
</div>
{{ end }}
