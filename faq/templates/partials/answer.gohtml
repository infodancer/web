{{- /* Answer */ -}}
<li class="faq-answer{{if .Accepted}} is-accepted{{end}}{{if .Deleted}} is-deleted{{end}}" id="faq-a-{{.ID}}">
<div class="faq-answer-stats" aria-label="Stats">
{{- if .Vote -}}
{{template "partials/vote_cell.gohtml" .Vote}}
{{- else -}}
<span class="faq-answer-score">{{.Score}}<small> score</small></span>
{{- end -}}
{{- if .Accepted -}}
<span class="app-badge faq-badge-accepted" title="Accepted answer">Accepted</span>
{{- end -}}
{{- if .CanAccept -}}
<form class="faq-accept" method="post" action="../../q/{{.QuestionID}}/accept"
      hx-post="../../q/{{.QuestionID}}/accept"
      hx-target="closest .faq-q-detail" hx-swap="innerHTML">
<input type="hidden" name="answer_id" value="{{.ID}}">
<button type="submit" class="faq-accept-btn{{if .Accepted}} is-accepted{{end}}">{{if .Accepted}}Unaccept{{else}}Accept{{end}}</button>
</form>
{{- end -}}
</div>
<div class="faq-answer-main">
<div class="faq-answer-body">
{{.BodyHTML | safe}}
</div>
<footer class="faq-answer-meta">
answered by <strong>{{.Author}}</strong>
<time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z"}}">{{.CreatedAt.Format "Jan 2, 2006"}}</time>
{{- if .EditedAt -}}
· edited <time datetime="{{.EditedAt.Format "2006-01-02T15:04:05Z"}}">{{.EditedAt.Format "Jan 2, 2006"}}</time>
{{- end -}}
{{- if .LocallyModified}} · Modified after import.{{end -}}
{{- if .Deleted}} · <span class="faq-deleted-note">deleted</span>{{end -}}
{{- if or .CanEdit .CanDelete .Deleted -}}
<span class="faq-answer-actions">
{{- if .CanEdit -}}
<button type="button" class="faq-link-btn"
        hx-get="../../a/{{.ID}}/edit" hx-target="#faq-a-{{.ID}}" hx-swap="outerHTML">Edit</button>
{{- end -}}
{{- if .CanDelete -}}
<form method="post" action="../../a/{{.ID}}/delete"
      hx-post="../../a/{{.ID}}/delete" hx-confirm="Delete this answer?"
      hx-target="closest .faq-q-detail" hx-swap="innerHTML">
<button type="submit" class="faq-link-btn faq-link-danger">Delete</button>
</form>
{{- end -}}
{{- if .Deleted -}}
<form method="post" action="../../a/{{.ID}}/restore"
      hx-post="../../a/{{.ID}}/restore"
      hx-target="closest .faq-q-detail" hx-swap="innerHTML">
<button type="submit" class="faq-link-btn">Restore</button>
</form>
{{- end -}}
</span>
{{- end -}}
</footer>
{{- with .Comments -}}
<ol class="app-comment-list" role="list">
{{range .}}{{template "partials/comment.gohtml" .}}{{end}}
</ol>
{{- end -}}
</div>
</li>
