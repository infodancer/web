{{define "title"}}{{if .Query}}Search: {{.Query}}{{else}}Search{{end}}{{with .Meta.SiteName}} — {{.}}{{end}}{{end}}

{{define "head"}}<link rel="stylesheet" href="{{.BasePath}}/static/search.css">{{end}}

{{define "content"}}
<section class="app-search">
  <h1>Search</h1>
  <form class="app-search-form" action="{{.BasePath}}/" method="get" role="search">
    <input type="search" name="q" value="{{.Query}}" placeholder="Search…"
           aria-label="Search query" autocomplete="off" autofocus
           hx-get="{{.BasePath}}/search"
           hx-trigger="keyup changed delay:200ms, search"
           hx-target="#search-results"
           hx-push-url="true">
    <button type="submit">Search</button>
  </form>
</section>
<div id="search-results" aria-live="polite">
{{template "partials/results.gohtml" .}}
</div>
{{end}}
