{{- /*
  base.gohtml renders the page through infodancer/ui's Layer 2 ui/document, so
  the chrome (nav, footer, meta, CSS, analytics, theme) is owned by ui and
  skinned per request by the host via Config.Chrome. The page template
  (pages/search.gohtml) supplies the content/title/head blocks; the embedded
  ui.DocumentData on the view supplies ui/document's chrome fields.
*/ -}}
{{ template "ui/document" . }}
